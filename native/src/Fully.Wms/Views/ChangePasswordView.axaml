<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fully.Wms.ViewModels"
             x:Class="Fully.Wms.Views.ChangePasswordView"
             x:DataType="vm:ChangePasswordViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="460" Margin="16,24" Spacing="16" HorizontalAlignment="Stretch">
      <Border Classes="notice warn" IsVisible="{Binding Forced}">
        <TextBlock Text="Az első belépés után új jelszót kell választanod. Addig a többi funkció nem érhető el." />
      </Border>
      <StackPanel>
        <TextBlock Classes="label" Text="Jelenlegi jelszó" />
        <TextBox Text="{Binding Current}" PasswordChar="•" Classes="revealPasswordButton" Classes.invalid="{Binding CurrentError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="fielderror" Text="{Binding CurrentError}" IsVisible="{Binding CurrentError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      <StackPanel>
        <TextBlock Classes="label" Text="Új jelszó (legalább 10 karakter)" />
        <TextBox Text="{Binding Next}" PasswordChar="•" Classes="revealPasswordButton" Classes.invalid="{Binding NextError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="fielderror" Text="{Binding NextError}" IsVisible="{Binding NextError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      <StackPanel>
        <TextBlock Classes="label" Text="Új jelszó még egyszer" />
        <TextBox Text="{Binding Again}" PasswordChar="•" Classes="revealPasswordButton" Classes.invalid="{Binding AgainError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="fielderror" Text="{Binding AgainError}" IsVisible="{Binding AgainError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      <Button Classes="primary" Content="Jelszó mentése" HorizontalAlignment="Stretch" Command="{Binding SaveCommand}" IsDefault="True" />
      <Button Content="Kijelentkezés" HorizontalAlignment="Stretch" Command="{Binding LogoutCommand}" IsVisible="{Binding Forced}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
