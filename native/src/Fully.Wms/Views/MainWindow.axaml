<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Fully.Wms.Views"
        x:Class="Fully.Wms.Views.MainWindow"
        Title="Fully WMS"
        Icon="/Assets/app.ico"
        Width="1280" Height="820"
        MinWidth="380" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        CanResize="True">
  <!-- An ordinary window: resizable, opens at a normal size, remembers its size and place. -->
  <views:MainView />
</Window>
