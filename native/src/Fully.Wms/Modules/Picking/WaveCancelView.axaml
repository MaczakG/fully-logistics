<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Fully.Wms.Modules.Picking"
             x:Class="Fully.Wms.Modules.Picking.WaveCancelView"
             x:DataType="local:WaveCancelViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="14">
      <TextBlock TextWrapping="Wrap" Text="{Binding Text}" />
      <StackPanel>
        <TextBlock Classes="label" Text="Ok" />
        <TextBox Text="{Binding Reason}" Classes.invalid="{Binding ReasonError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="fielderror" Text="{Binding ReasonError}" IsVisible="{Binding ReasonError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      <Button Classes="primary danger" HorizontalAlignment="Stretch" Content="Megszakítás" Command="{Binding SaveCommand}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
