<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Fully.Wms.Modules.Settings"
             xmlns:o="using:Fully.Wms.Modules.Orders"
             xmlns:ctl="using:Fully.Wms.Controls"
             xmlns:p="using:Fully.Wms.Modules.Partners"
             xmlns:m="using:Fully.Wms.Core.Models"
             x:Class="Fully.Wms.Modules.Settings.SizeFormView"
             x:DataType="local:SizeFormViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="10">
      <Border Classes="notice danger" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding Error}" />
      </Border>
      <Border Classes="notice" IsVisible="{Binding UsedNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding UsedNote}" />
      </Border>
      <UniformGrid Columns="2">
          <StackPanel Margin="0,0,8,8">
            <TextBlock Classes="label" Text="Kód" />
            <TextBox Text="{Binding Code}" Classes.invalid="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=code}" />
            <TextBlock Classes="muted small" Text="Rövid, ékezet nélkül, pl. XXL." Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=code}"
                       IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=code}" />
          </StackPanel>
          <StackPanel Margin="0,0,8,8">
            <TextBlock Classes="label" Text="Megnevezés" />
            <TextBox Text="{Binding Name}" PlaceholderText="Polchely XXL" Classes.invalid="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=name}" />
            <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=name}"
                       IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=name}" />
          </StackPanel>
      </UniformGrid>
      <UniformGrid Columns="4">
          <StackPanel Margin="0,0,8,8">
            <TextBlock Classes="label" Text="Szélesség (cm)" />
            <TextBox Text="{Binding WidthCm}" Classes="num" Classes.invalid="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=width_cm}" />
            <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=width_cm}"
                       IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=width_cm}" />
          </StackPanel>
          <StackPanel Margin="0,0,8,8">
            <TextBlock Classes="label" Text="Mélység (cm)" />
            <TextBox Text="{Binding DepthCm}" Classes="num" Classes.invalid="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=depth_cm}" />
            <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=depth_cm}"
                       IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=depth_cm}" />
          </StackPanel>
          <StackPanel Margin="0,0,8,8">
            <TextBlock Classes="label" Text="Magasság (cm)" />
            <TextBox Text="{Binding HeightCm}" Classes="num" Classes.invalid="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=height_cm}" />
            <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=height_cm}"
                       IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=height_cm}" />
          </StackPanel>
          <StackPanel Margin="0,0,8,8">
            <TextBlock Classes="label" Text="Teherbírás (kg)" />
            <TextBox Text="{Binding MaxKg}" Classes="num" Classes.invalid="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=max_kg}" />
            <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=max_kg}"
                       IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=max_kg}" />
          </StackPanel>
      </UniformGrid>
      <UniformGrid Columns="2">
          <StackPanel Margin="0,0,8,8">
            <TextBlock Classes="label" Text="Sorrend (nem kötelező)" />
            <TextBox Text="{Binding Sort}" Classes.invalid="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=sort}" />
            <TextBlock Classes="muted small" Text="Ebben a sorrendben jelenik meg a listákban." Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=sort}"
                       IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=sort}" />
          </StackPanel>
          <Panel />
      </UniformGrid>
      <CheckBox Content="Aktív, új raktárhelyhez választható" IsChecked="{Binding Active}" />
      <Button Classes="primary" HorizontalAlignment="Stretch" Content="{Binding SubmitText}" Command="{Binding SaveCommand}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
