<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Fully.Wms.Modules.Users"
             xmlns:o="using:Fully.Wms.Modules.Orders"
             xmlns:ctl="using:Fully.Wms.Controls"
             x:Class="Fully.Wms.Modules.Users.PasswordShownView"
             x:DataType="local:PasswordShownViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">
      <Border Classes="notice warn"><TextBlock Text="{Binding Note}" /></Border>
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="PasswordBox" Text="{Binding Password, Mode=OneWay}" IsReadOnly="True" Classes="mono" FontSize="20" />
        <Button Grid.Column="1" Classes="dark" Margin="8,0,0,0" Click="Copy">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconCopy}" /><TextBlock Text="Másolás" /></StackPanel>
        </Button>
      </Grid>
      <TextBlock Classes="muted small" Text="{Binding Login}" TextWrapping="Wrap" />
      <Button Classes="primary" HorizontalAlignment="Stretch" Content="Kész" Command="{Binding CloseCommand}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
