<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Fully.Wms.Modules.Transport"
             x:Class="Fully.Wms.Modules.Transport.PickupCloseView"
             x:DataType="local:PickupCloseViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">
      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold" />
      <TextBlock Classes="muted small" TextWrapping="Wrap"
                 Text="A rendelések állapota Feladva lesz, a webshopok megkapják a nyomkövetési számokat. Ez nem vonható vissza." />
      <Border Classes="notice warn" IsVisible="{Binding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding Warning}" />
      </Border>
      <StackPanel>
        <TextBlock Classes="label" Text="A fuvarozó manifesztszáma (nem kötelező)" />
        <TextBox Text="{Binding ManifestNumber}" />
        <TextBlock Classes="muted small" Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
      <Border Classes="notice" IsVisible="{Binding Progress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding Progress}" />
      </Border>
      <Button Classes="primary" HorizontalAlignment="Stretch" Content="Lezárás és feladás" Command="{Binding SaveCommand}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
