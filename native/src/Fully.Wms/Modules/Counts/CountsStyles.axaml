<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The count screens (web app: .cnt-*) -->
  <Style Selector="Border.feedback">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Background" Value="{DynamicResource InfoBg}" />
    <Setter Property="BorderThickness" Value="4,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Info}" />
  </Style>
  <Style Selector="Border.feedback TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.feedback.ok">
    <Setter Property="Background" Value="{DynamicResource OkBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ok}" />
  </Style>
  <Style Selector="Border.feedback.warn">
    <Setter Property="Background" Value="{DynamicResource WarnBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Warn}" />
  </Style>
  <Style Selector="Border.feedback.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
  </Style>

  <Style Selector="Border.entry">
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="14" />
  </Style>
  <Style Selector="Border.linecard">
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1,1,1,1" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="Border.linecard.active">
    <Setter Property="BorderBrush" Value="{StaticResource HiVis}" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <Style Selector="Border.linecard.done">
    <Setter Property="BorderBrush" Value="{DynamicResource Ok}" />
  </Style>
  <Style Selector="TextBlock.sku">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="ProgressBar.line">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource HiVis}" />
    <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ProgressBar.line.done">
    <Setter Property="Foreground" Value="{DynamicResource Ok}" />
  </Style>
  <Style Selector="TextBox.qty">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>
  <!-- The status tabs of the wave list and the key figures that open a list -->
  <Style Selector="ToggleButton.chip">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ink}" />
    <Setter Property="Foreground" Value="{DynamicResource Paper}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Border.kpi.ok">
    <Setter Property="BorderBrush" Value="{DynamicResource Ok}" />
  </Style>
  <Style Selector="Button.kpibutton">
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- The lines, grouped by location -->
  <Style Selector="Border.taskrow">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="Border.taskrow.group">
    <Setter Property="BorderThickness" Value="0,2,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
  </Style>
  <Style Selector="Border.taskrow.current">
    <Setter Property="Background" Value="{DynamicResource WarnBg}" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14" />
  </Style>
  <Style Selector="ProgressBar.big">
    <Setter Property="Height" Value="10" />
    <Setter Property="MinHeight" Value="10" />
  </Style>
  <Style Selector="Border.taskrow.surplus">
    <Setter Property="Background" Value="{DynamicResource OkBg}" />
  </Style>
  <Style Selector="Border.taskrow.shortage">
    <Setter Property="Background" Value="{DynamicResource DangerBg}" />
  </Style>
  <Style Selector="Border.taskrow.changed">
    <Setter Property="Background" Value="{DynamicResource WarnBg}" />
  </Style>
  <Style Selector="Border.grouphead">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
  </Style>

  <!-- The locations of the count as buttons: done, partly counted, not counted, the current one -->
  <Style Selector="Button.loc">
    <Setter Property="MinWidth" Value="92" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="BorderThickness" Value="0,0,0,4" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="Background" Value="{DynamicResource Panel}" />
  </Style>
  <Style Selector="Button.loc.partial">
    <Setter Property="BorderBrush" Value="{DynamicResource Warn}" />
  </Style>
  <Style Selector="Button.loc.done">
    <Setter Property="BorderBrush" Value="{DynamicResource Ok}" />
    <Setter Property="Background" Value="{DynamicResource OkBg}" />
  </Style>
  <Style Selector="Button.loc.current">
    <Setter Property="BorderBrush" Value="{StaticResource HiVis}" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <Style Selector="TextBlock.loccode">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="30" />
  </Style>
  <Style Selector="TextBox.cqty">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Width" Value="92" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>
  <Style Selector="Button.square">
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
</Styles>
