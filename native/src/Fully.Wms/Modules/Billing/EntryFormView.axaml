<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Fully.Wms.Modules.Billing"
             xmlns:o="using:Fully.Wms.Modules.Orders"
             xmlns:ctl="using:Fully.Wms.Controls"
             xmlns:p="using:Fully.Wms.Modules.Partners"
             xmlns:m="using:Fully.Wms.Core.Models"
             x:Class="Fully.Wms.Modules.Billing.EntryFormView"
             x:DataType="local:EntryFormViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="10">
      <Border Classes="notice danger" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding Error}" />
      </Border>
      <StackPanel Margin="0,0,0,8">
        <TextBlock Classes="label" Text="Ügyfél" />
        <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding Client}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsNew}">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="o:OrderChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=partner_id}"
                   IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=partner_id}" />
      </StackPanel>
      <UniformGrid Columns="2">
          <StackPanel Margin="0,0,8,8">
            <TextBlock Classes="label" Text="Dátum" />
            <CalendarDatePicker SelectedDate="{Binding Date}" HorizontalAlignment="Stretch" />
            <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=date}"
                       IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=date}" />
          </StackPanel>
          <StackPanel Margin="0,0,8,8">
            <TextBlock Classes="label" Text="Típus" />
            <ComboBox ItemsSource="{x:Static local:EntryFormViewModel.Kinds}" SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="o:OrderChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=kind}"
                       IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=kind}" />
          </StackPanel>
      </UniformGrid>
      <StackPanel IsVisible="{Binding IsCustom}" Margin="0,0,0,8">
        <TextBlock Classes="label" Text="Egyedi tétel" />
        <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding Item}" HorizontalAlignment="Stretch" PlaceholderText="Válassz tételt">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="o:OrderChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Classes="muted small" Text="Az ügyfél Tarifák fülén felvett, darabonként számlázott tételek." Margin="0,4,0,0" />
        <TextBlock Classes="small neg" Text="{Binding ItemsNote}" IsVisible="{Binding ItemsNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=custom_item_id}"
                   IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=custom_item_id}" />
      </StackPanel>
      <UniformGrid Columns="2">
          <StackPanel Margin="0,0,8,8">
            <TextBlock Classes="label" Text="Mennyiség" />
            <TextBox Text="{Binding Qty}" Classes="num" Classes.invalid="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=qty}" />
            <TextBlock Classes="muted small" Text="Óradíjas munkánál órában." Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=qty}"
                       IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=qty}" />
          </StackPanel>
          <Panel />
      </UniformGrid>
      <StackPanel Margin="0,0,0,8">
        <TextBlock Classes="label" Text="Megjegyzés (nem kötelező)" />
        <TextBox Text="{Binding Note}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Classes.invalid="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=note}" />
        <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=note}"
                   IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=note}" />
      </StackPanel>
      <Button Classes="primary" HorizontalAlignment="Stretch" Content="{Binding SubmitText}" Command="{Binding SaveCommand}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
