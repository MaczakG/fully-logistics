<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Fully.Wms.Modules.Billing"
             xmlns:o="using:Fully.Wms.Modules.Orders"
             xmlns:ctl="using:Fully.Wms.Controls"
             xmlns:p="using:Fully.Wms.Modules.Partners"
             xmlns:m="using:Fully.Wms.Core.Models"
             x:Class="Fully.Wms.Modules.Billing.VoidView"
             x:DataType="local:VoidViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="10">
      <Border Classes="notice danger" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding Error}" />
      </Border>
      <Border Classes="notice warn" IsVisible="{Binding WasInvoiced}"><TextBlock Text="{Binding InvoiceNote}" /></Border>
      <StackPanel Margin="0,0,0,8">
        <TextBlock Classes="label" Text="Indoklás" />
        <TextBox Text="{Binding Reason}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Classes.invalid="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=reason}" />
        <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=reason}"
                   IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=reason}" />
      </StackPanel>
      <StackPanel IsVisible="{Binding WasInvoiced}">
        <CheckBox Content="{Binding CancelledLabel}" IsChecked="{Binding InvoiceCancelled}" />
        <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=invoice_cancelled}"
                   IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=invoice_cancelled}" />
      </StackPanel>
      <TextBlock Classes="muted small" Text="Érvénytelenítés után újra elkészítheted piszkozatként." />
      <Button Classes="primary danger" HorizontalAlignment="Stretch" Content="Érvénytelenítés" Command="{Binding SaveCommand}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
