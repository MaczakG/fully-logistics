<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Fully.Wms.Modules.Billing"
             xmlns:o="using:Fully.Wms.Modules.Orders"
             xmlns:ctl="using:Fully.Wms.Controls"
             xmlns:p="using:Fully.Wms.Modules.Partners"
             xmlns:m="using:Fully.Wms.Core.Models"
             x:Class="Fully.Wms.Modules.Billing.EntriesTabView"
             x:DataType="local:EntriesTab">
  <UserControl.Styles>
    <StyleInclude Source="avares://Fully.Wms/Modules/Orders/OrdersStyles.axaml" />
  </UserControl.Styles>
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="320,*,Auto">
      <StackPanel>
        <TextBlock Classes="label" Text="Ügyfél" />
        <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding Client}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="o:OrderChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <Button Grid.Column="2" Classes="primary" Command="{Binding NewCommand}" IsVisible="{Binding CanCreate}" VerticalAlignment="Bottom">
        <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconPlus}" /><TextBlock Text="Új tétel" /></StackPanel>
      </Button>
    </Grid>
    <Border Classes="notice" IsVisible="{Binding IsEmpty}"><TextBlock Text="Ebben a hónapban nincs rögzített tétel." /></Border>
    <Border Classes="panel" Padding="0" IsVisible="{Binding !IsEmpty}">
      <StackPanel>
        <Grid ColumnDefinitions="110,*,*,120,110,110,170,90" Margin="20,8,20,4">
          <TextBlock Classes="dt" Text="Dátum" />
          <TextBlock Grid.Column="1" Classes="dt" Text="Ügyfél" />
          <TextBlock Grid.Column="2" Classes="dt" Text="Tétel" />
          <TextBlock Grid.Column="3" Classes="dt" Text="Mennyiség" TextAlignment="Right" Margin="0,6,8,0" />
          <TextBlock Grid.Column="4" Classes="dt" Text="Egységár" TextAlignment="Right" Margin="0,6,8,0" />
          <TextBlock Grid.Column="5" Classes="dt" Text="Összeg" TextAlignment="Right" Margin="0,6,8,0" />
          <TextBlock Grid.Column="6" Classes="dt" Text="Rögzítette" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Items}" Margin="10,0,10,10">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:EntryItem">
              <Border Classes="taskrow">
                <Grid ColumnDefinitions="110,*,*,120,110,110,170,90">
                  <TextBlock Text="{Binding DateText}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Entry.PartnerName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted small" Text="{Binding Entry.PartnerCode}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding ItemText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted small" Text="{Binding Entry.Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Column="3" Classes="mono" Text="{Binding QtyText}" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Classes="mono" Text="{Binding PriceText}" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="5" Classes="mono" Text="{Binding AmountText}" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="6" VerticalAlignment="Center">
                    <TextBlock Classes="small" Text="{Binding Entry.CreatedByName}" />
                    <TextBlock Classes="muted small" Text="{Binding CreatedText}" />
                  </StackPanel>
                  <Panel Grid.Column="7" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Classes="tag" IsVisible="{Binding Locked}" ToolTip.Tip="{Binding LockedTip}"><TextBlock Text="Lezárt hónap" /></Border>
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !Locked}">
                      <Button Classes="ghost" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Szerkesztés"><PathIcon Data="{StaticResource IconEdit}" /></Button>
                      <Button Classes="ghost" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" ToolTip.Tip="Törlés"><PathIcon Data="{StaticResource IconTrash}" /></Button>
                    </StackPanel>
                  </Panel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="muted" Text="{Binding TotalText}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Továbbiak" Command="{Binding MoreCommand}" IsVisible="{Binding HasMore}" />
    </Grid>
  </StackPanel>
</UserControl>
