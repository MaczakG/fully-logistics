<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Fully.Wms.Modules.Partners"
             xmlns:o="using:Fully.Wms.Modules.Orders"
             xmlns:ctl="using:Fully.Wms.Controls"
             x:Class="Fully.Wms.Modules.Partners.PartnerContactsView"
             x:DataType="local:PartnerContactsTab">
  <UserControl.Styles>
    <StyleInclude Source="avares://Fully.Wms/Modules/Orders/OrdersStyles.axaml" />
  </UserControl.Styles>
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="section" Text="Kapcsolattartók" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="primary" Command="{Binding NewCommand}" IsVisible="{Binding CanEdit}">
        <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconPlus}" /><TextBlock Text="Új kapcsolattartó" /></StackPanel>
      </Button>
    </Grid>
    <Border Classes="notice" IsVisible="{Binding IsEmpty}"><TextBlock Text="Még nincs kapcsolattartó." /></Border>
    <Border Classes="panel" Padding="0" IsVisible="{Binding !IsEmpty}">
      <StackPanel>
        <Grid ColumnDefinitions="*,240,160,*,270" Margin="10,0,10,6">
          <TextBlock Classes="dt" Text="Név" />
          <TextBlock Grid.Column="1" Classes="dt" Text="E-mail" />
          <TextBlock Grid.Column="2" Classes="dt" Text="Telefon" />
          <TextBlock Grid.Column="3" Classes="dt" Text="Megjegyzés" />
          <TextBlock Grid.Column="4" Classes="dt" Text="" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:ContactRow">
              <Border Classes="taskrow">
                <Grid ColumnDefinitions="*,240,160,*,270">
                  <StackPanel VerticalAlignment="Center">
                    <WrapPanel>
                      <TextBlock Text="{Binding Contact.Name}" FontWeight="SemiBold" Margin="0,0,8,0" />
                      <Border Classes="tag hi" IsVisible="{Binding Contact.IsPrimary}"><TextBlock Text="Elsődleges" /></Border>
                    </WrapPanel>
                    <TextBlock Classes="muted small" Text="{Binding Contact.Position}" />
                  </StackPanel>
                  <SelectableTextBlock Grid.Column="1" Text="{Binding Contact.Email}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <SelectableTextBlock Grid.Column="2" Text="{Binding Contact.Phone}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Classes="small" Text="{Binding Contact.Notes}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="Legyen elsődleges" Command="{Binding PrimaryCommand}" IsVisible="{Binding CanMakePrimary}" />
                    <Button Classes="ghost" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Szerkesztés"><PathIcon Data="{StaticResource IconEdit}" /></Button>
                    <Button Classes="ghost" Command="{Binding RemoveCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Törlés"><PathIcon Data="{StaticResource IconTrash}" /></Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
