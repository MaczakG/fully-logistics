<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Fully.Wms.Modules.Partners"
             xmlns:o="using:Fully.Wms.Modules.Orders"
             xmlns:ctl="using:Fully.Wms.Controls"
             x:Class="Fully.Wms.Modules.Partners.PartnerContractsView"
             x:DataType="local:PartnerContractsTab">
  <UserControl.Styles>
    <StyleInclude Source="avares://Fully.Wms/Modules/Orders/OrdersStyles.axaml" />
  </UserControl.Styles>
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="section" Text="Szerződések" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="primary" Command="{Binding NewContractCommand}" IsVisible="{Binding CanEdit}">
        <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconPlus}" /><TextBlock Text="Új szerződés" /></StackPanel>
      </Button>
    </Grid>
    <Border Classes="notice" IsVisible="{Binding NoContracts}"><TextBlock Text="Még nincs rögzített szerződés." /></Border>
    <Border Classes="panel" Padding="0" IsVisible="{Binding !NoContracts}">
      <StackPanel>
        <Grid ColumnDefinitions="140,*,110,150,110,120,90,100" Margin="10,0,10,6">
          <TextBlock Classes="dt" Text="Szám" />
          <TextBlock Grid.Column="1" Classes="dt" Text="Megnevezés" />
          <TextBlock Grid.Column="2" Classes="dt" Text="Kezdete" />
          <TextBlock Grid.Column="3" Classes="dt" Text="Lejárata" />
          <TextBlock Grid.Column="4" Classes="dt" Text="Felmondás" TextAlignment="Right" Margin="0,6,8,0" />
          <TextBlock Grid.Column="5" Classes="dt" Text="Állapot" />
          <TextBlock Grid.Column="6" Classes="dt" Text="Dokumentum" TextAlignment="Right" Margin="0,6,8,0" />
          <TextBlock Grid.Column="7" Classes="dt" Text="" />
        </Grid>
        <ItemsControl ItemsSource="{Binding ContractRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:ContractRow">
              <Border Classes="taskrow">
                <Grid ColumnDefinitions="140,*,110,150,110,120,90,100">
                  <TextBlock Classes="mono" Text="{Binding NumberText}" Classes.muted="{Binding NoNumber}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Contract.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted small" Text="{Binding Contract.Notes}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding StartText}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EndText}" />
                    <TextBlock Classes="small neg" Text="{Binding ExpiryNote}" IsVisible="{Binding ExpiryNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <TextBlock Grid.Column="4" Classes="mono" Text="{Binding NoticeText}" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <ctl:StatusTag Grid.Column="5" Group="contract" Status="{Binding Contract.Status}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="6" Classes="mono" Text="{Binding DocumentsText}" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Classes="ghost" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Szerkesztés"><PathIcon Data="{StaticResource IconEdit}" /></Button>
                    <Button Classes="ghost" Command="{Binding RemoveCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Törlés"><PathIcon Data="{StaticResource IconTrash}" /></Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
      <TextBlock Classes="section" Text="Dokumentumok" VerticalAlignment="Center" />
      <Button Grid.Column="1" Command="{Binding UploadCommand}" IsVisible="{Binding CanEdit}">
        <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconUpload}" /><TextBlock Text="Feltöltés" /></StackPanel>
      </Button>
    </Grid>
    <Border Classes="notice" IsVisible="{Binding NoDocuments}"><TextBlock Text="Még nincs feltöltött dokumentum." /></Border>
    <Border Classes="panel" Padding="0" IsVisible="{Binding !NoDocuments}">
      <StackPanel>
        <Grid ColumnDefinitions="*,100,*,170,150" Margin="10,0,10,6">
          <TextBlock Classes="dt" Text="Fájl" />
          <TextBlock Grid.Column="1" Classes="dt" Text="Típus" />
          <TextBlock Grid.Column="2" Classes="dt" Text="Szerződés" />
          <TextBlock Grid.Column="3" Classes="dt" Text="Feltöltve" />
          <TextBlock Grid.Column="4" Classes="dt" Text="" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Documents}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:DocumentRow">
              <Border Classes="taskrow">
                <Grid ColumnDefinitions="*,100,*,170,150">
                  <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Classes="link" Command="{Binding OpenCommand}" ToolTip.Tip="Megnyitás"><TextBlock Text="{Binding Document.Filename}" TextTrimming="CharacterEllipsis" /></Button>
                    <TextBlock Classes="muted small" Text="{Binding SizeText}" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="tag" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding KindText}" /></Border>
                  <TextBlock Grid.Column="2" Text="{Binding ContractText}" Classes.muted="{Binding NoContract}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                  <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UploadedText}" />
                    <TextBlock Classes="muted small" Text="{Binding Document.UploadedByName}" />
                  </StackPanel>
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Classes="ghost" Command="{Binding OpenCommand}" ToolTip.Tip="Letöltés"><PathIcon Data="{StaticResource IconDownload}" /></Button>
                    <Button Classes="ghost" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Adatok"><PathIcon Data="{StaticResource IconEdit}" /></Button>
                    <Button Classes="ghost" Command="{Binding RemoveCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Törlés"><PathIcon Data="{StaticResource IconTrash}" /></Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
