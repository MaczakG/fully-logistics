<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Fully.Wms.Modules.Partners"
             xmlns:o="using:Fully.Wms.Modules.Orders"
             xmlns:ctl="using:Fully.Wms.Controls"
             x:Class="Fully.Wms.Modules.Partners.CustomItemFormView"
             x:DataType="local:CustomItemFormViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="10">
      <Border Classes="notice danger" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding Error}" />
      </Border>
        <StackPanel Margin="0,0,8,8">
          <TextBlock Classes="label" Text="Megnevezés" />
          <TextBox Text="{Binding Name}" PlaceholderText="pl. Raklapfóliázás" Classes.invalid="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=name}" />
          <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=name}"
                     IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=name}" />
        </StackPanel>
        <UniformGrid Columns="3">
          <StackPanel Margin="0,0,8,8">
            <TextBlock Classes="label" Text="Típus" />
            <ComboBox ItemsSource="{x:Static local:CustomItemFormViewModel.Kinds}" SelectedItem="{Binding ItemKind}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="o:OrderChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=kind}"
                       IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=kind}" />
          </StackPanel>
          <StackPanel Margin="0,0,8,8">
            <TextBlock Classes="label" Text="Egység" />
            <TextBox Text="{Binding Unit}" Classes.invalid="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=unit}" />
            <TextBlock Classes="muted small" Text="Mennyiség alapú tételnél, pl. db, raklap, óra." Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=unit}"
                       IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=unit}" />
          </StackPanel>
          <StackPanel Margin="0,0,8,8">
            <TextBlock Classes="label" Text="Nettó ár (Ft)" />
            <TextBox Text="{Binding Price}" Classes="num" Classes.invalid="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=price}" />
            <TextBlock Classes="fielderror" Text="{Binding Errors, Converter={x:Static o:OrderFormat.FieldError}, ConverterParameter=price}"
                       IsVisible="{Binding Errors, Converter={x:Static o:OrderFormat.HasFieldError}, ConverterParameter=price}" />
          </StackPanel>
        </UniformGrid>
        <CheckBox Content="Aktív (számlázásra kerül)" IsChecked="{Binding Active}" />
      <Button Classes="primary" HorizontalAlignment="Stretch" Content="{Binding SubmitText}" Command="{Binding SaveCommand}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
