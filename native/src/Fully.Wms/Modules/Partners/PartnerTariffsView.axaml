<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Fully.Wms.Modules.Partners"
             xmlns:o="using:Fully.Wms.Modules.Orders"
             xmlns:ctl="using:Fully.Wms.Controls"
             x:Class="Fully.Wms.Modules.Partners.PartnerTariffsView"
             x:DataType="local:PartnerTariffsTab">
  <UserControl.Styles>
    <StyleInclude Source="avares://Fully.Wms/Modules/Orders/OrdersStyles.axaml" />
  </UserControl.Styles>
  <StackPanel Spacing="12">
    <Border Classes="notice" IsVisible="{Binding ReadOnly}">
      <TextBlock Text="Itt csak megtekintheted a díjakat. A módosításhoz „Partnerek: tarifák és integrációk módosítása” jog kell." />
    </Border>
    <Border Classes="notice danger" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding Error}" />
    </Border>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Classes="section" Text="Díjtételek" />
        <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Az alapérték a Beállítások alapértelmezett tarifája. Az ettől eltérő díjakat kiemeljük." />
      </StackPanel>
      <Border Grid.Column="1" Classes="tag" Classes.hi="{Binding HasDiffs}" Classes.ok="{Binding !HasDiffs}" VerticalAlignment="Center"><TextBlock Text="{Binding DiffText}" /></Border>
    </Grid>
    <Border Classes="panel" Padding="0">
      <StackPanel>
        <Grid ColumnDefinitions="*,170,130,150,80" Margin="10,0,10,6">
          <TextBlock Classes="dt" Text="Tétel" />
          <TextBlock Grid.Column="1" Classes="dt" Text="Egység" />
          <TextBlock Grid.Column="2" Classes="dt" Text="Alapérték" TextAlignment="Right" Margin="0,6,8,0" />
          <TextBlock Grid.Column="3" Classes="dt" Text="Ügyfél díja" />
          <TextBlock Grid.Column="4" Classes="dt" Text="" />
        </Grid>
        <ItemsControl ItemsSource="{Binding TariffGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:TariffGroup">
              <StackPanel>
                <Border Classes="grouphead"><TextBlock Text="{Binding Label}" FontWeight="Bold" /></Border>
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:TariffInput">
                <Border Classes="taskrow">
                  <Grid ColumnDefinitions="*,170,130,150,80">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding Sub}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Classes="mono" Text="{Binding DefaultText}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                      <TextBox Classes="num" Text="{Binding Value}" IsReadOnly="{Binding ReadOnly}" Classes.invalid="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Classes="fielderror" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <Border Grid.Column="4" Classes="tag hi" IsVisible="{Binding Differs}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Eltér" /></Border>
                  </Grid>
                </Border>
              </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <StackPanel Margin="0,8,0,0">
      <TextBlock Classes="section" Text="Tárolási díjak" />
      <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Egy raktárhely havi díja méretenként. A számlázás a napi foglaltság szerint időarányos. Új méretet a Beállítások &gt; Raktárhelyek alatt vehetsz fel." />
    </StackPanel>
    <Border Classes="notice" IsVisible="{Binding NoStorage}"><TextBlock Text="Nincs aktív raktárhely méret. Vegyél fel méretet a Beállítások &gt; Raktárhelyek alatt." /></Border>
    <Border Classes="panel" Padding="0" IsVisible="{Binding !NoStorage}">
      <StackPanel>
        <Grid ColumnDefinitions="*,170,130,150,80" Margin="10,0,10,6">
          <TextBlock Classes="dt" Text="Méret" />
          <TextBlock Grid.Column="1" Classes="dt" Text="Befoglaló méret" />
          <TextBlock Grid.Column="2" Classes="dt" Text="Alapérték" TextAlignment="Right" Margin="0,6,8,0" />
          <TextBlock Grid.Column="3" Classes="dt" Text="Ügyfél díja / hó" />
          <TextBlock Grid.Column="4" Classes="dt" Text="" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Storage}">
          <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:TariffInput">
                <Border Classes="taskrow">
                  <Grid ColumnDefinitions="*,170,130,150,80">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding Sub}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Classes="mono" Text="{Binding DefaultText}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                      <TextBox Classes="num" Text="{Binding Value}" IsReadOnly="{Binding ReadOnly}" Classes.invalid="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Classes="fielderror" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <Border Grid.Column="4" Classes="tag hi" IsVisible="{Binding Differs}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Eltér" /></Border>
                  </Grid>
                </Border>
              </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding CanEdit}">
      <Button Command="{Binding ResetCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconRefresh}" /><TextBlock Text="Visszaállítás alapra" /></StackPanel>
      </Button>
      <Button Classes="primary" Command="{Binding SaveCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconCheck}" /><TextBlock Text="Tarifák mentése" /></StackPanel>
      </Button>
    </StackPanel>

    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
      <StackPanel>
        <TextBlock Classes="section" Text="Egyedi tételek" />
        <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Az ügyfélre szabott díjak: havi fix díj, vagy rögzített mennyiség szerint számlázott tétel (pl. raklapfóliázás)." />
      </StackPanel>
      <Button Grid.Column="1" Command="{Binding NewItemCommand}" IsVisible="{Binding CanEdit}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconPlus}" /><TextBlock Text="Új egyedi tétel" /></StackPanel>
      </Button>
    </Grid>
    <Border Classes="notice" IsVisible="{Binding NoCustom}"><TextBlock Text="Nincs egyedi tétel." /></Border>
    <Border Classes="panel" Padding="0" IsVisible="{Binding !NoCustom}">
      <StackPanel>
        <Grid ColumnDefinitions="*,170,170,100,100" Margin="10,0,10,6">
          <TextBlock Classes="dt" Text="Megnevezés" />
          <TextBlock Grid.Column="1" Classes="dt" Text="Típus" />
          <TextBlock Grid.Column="2" Classes="dt" Text="Ár" TextAlignment="Right" Margin="0,6,8,0" />
          <TextBlock Grid.Column="3" Classes="dt" Text="Állapot" />
          <TextBlock Grid.Column="4" Classes="dt" Text="" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Custom}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:CustomItemRow">
              <Border Classes="taskrow">
                <Grid ColumnDefinitions="*,170,170,100,100">
                  <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding KindText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="mono" Text="{Binding PriceText}" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <Panel Grid.Column="3" VerticalAlignment="Center">
                    <Border Classes="tag ok" IsVisible="{Binding Item.Active}" HorizontalAlignment="Left"><TextBlock Text="Aktív" /></Border>
                    <Border Classes="tag" IsVisible="{Binding !Item.Active}" HorizontalAlignment="Left"><TextBlock Text="Inaktív" /></Border>
                  </Panel>
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Classes="ghost" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Szerkesztés"><PathIcon Data="{StaticResource IconEdit}" /></Button>
                    <Button Classes="ghost" Command="{Binding RemoveCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Törlés"><PathIcon Data="{StaticResource IconTrash}" /></Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
