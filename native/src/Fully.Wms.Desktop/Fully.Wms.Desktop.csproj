<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WMS on Windows, macOS and Linux, in an ordinary resizable window (Views/MainWindow). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fully.Wms.Desktop</RootNamespace>
    <AssemblyName>FullyWms</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Fully.Wms\Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fully.Wms\Fully.Wms.csproj" />
  </ItemGroup>
</Project>
